{
  // Cloudflare Workers 設定。Worker 名はダッシュボードで作成済みの「subsidy」と一致させること。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subsidy",
  "main": "src/worker.js",
  // デプロイの前に、jGrants データの取得と制度ページ（/grants/）の生成を行う。
  // Cloudflare の Git 連携のビルドと、GitHub Actions のデプロイの、どちらでも同じ内容になるようにする
  "build": { "command": "npm run build:grants" },
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // 静的ファイル（HTML/CSS/JS/画像/jGrants データ）。/api/* と / だけを Worker に回す
    "directory": "./public",
    "binding": "ASSETS",
    // 既存の URL（/guide.html など）をそのまま保つ（/guide への転送をしない）
    "html_handling": "none",
    "run_worker_first": ["/api/*", "/"]
  },
  "observability": { "enabled": true },
  // お問い合わせフォームのメール送信（Cloudflare Email Routing が有効なドメインで利用できる）
  "send_email": [{ "name": "CONTACT_EMAIL" }],
  // 会員（Google ログイン）とマイページのデータ。次の手順を終えてから、下の2行のコメントを外す。
  // 1) npx wrangler d1 create subsidy-members  → 表示された database_id を下に書く
  // 2) npx wrangler d1 migrations apply subsidy-members --remote
  // 3) Secret GOOGLE_CLIENT_ID を登録（Google Cloud の OAuth クライアントID。承認済みの JavaScript 生成元に https://hojyokin.net を追加）
  // DB のバインディングがない間は、会員機能は自動でオフになり、マイページはこのブラウザの保存だけで動く。
  // "d1_databases": [{ "binding": "DB", "database_name": "subsidy-members", "database_id": "（create で表示された ID）", "migrations_dir": "migrations" }],
  "vars": {
    // 使用するモデル。ダッシュボードで変数を足す場合は、デプロイで消えないよう Secret として登録する
    "CLAUDE_MODEL": "claude-opus-5-5"
  }
  // Secret（wrangler secret put / ダッシュボード）: ANTHROPIC_API_KEY, CONTACT_TO（お問い合わせの送信先。Email Routing で確認済みのアドレス）, GOOGLE_CLIENT_ID（任意）
}
